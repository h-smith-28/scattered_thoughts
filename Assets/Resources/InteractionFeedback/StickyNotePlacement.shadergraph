{
    "m_SGVersion": 0,
    "m_Type": "UnityEditor.ShaderGraph.StickyNoteData",
    "m_ObjectId": "83c70d7bc2864e7db23e9977105de25c",
    "m_Title": "HOW THIS WALL PREVIEW WORKS",
    "m_Content": "UV runs from 0 to 1 across the note. Minimum(UV, 1-UV) finds how near each pixel is to an edge. Step + One Minus makes a border. Lerp gives the middle a faint fill and the border a stronger opacity. All three settings and Sky Blue Color are editable on the material. Code only chooses a valid wall position and draws the quad.",
    "m_TextSize": 0,
    "m_Theme": 0,
    "m_Position": {
        "serializedVersion": "2",
        "x": -1200.0,
        "y": -500.0,
        "width": 710.0,
        "height": 300.0
    },
    "m_Group": {
        "m_Id": ""
    }
}

